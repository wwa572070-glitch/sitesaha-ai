# ===== 筑安智培 V8 在线部署配置 =====
# 密钥只放在服务器/云平台环境变量中，不要提交到 Git，也不要发给前端用户。
SITESHAHA_LLM_MODE=on
SITESHAHA_LLM_BASE_URL=https://api.deepseek.com/v1
SITESHAHA_LLM_API_KEY=replace-with-your-deepseek-api-key
SITESHAHA_LLM_MODEL=deepseek-chat
SITESHAHA_LLM_API_STYLE=chat

# DeepSeek 当前文字模型不支持图片分析。若要启用“拍照问安全”，
# 可单独填写一个 OpenAI 兼容的多模态视觉服务；不需要时保持留空。
SITESHAHA_VISION_BASE_URL=
SITESHAHA_VISION_API_KEY=
SITESHAHA_VISION_MODEL=
SITESHAHA_VISION_API_STYLE=chat

SITESHAHA_LLM_TIMEOUT_SECONDS=120
SITESHAHA_TOP_K=5
SITESHAHA_MAX_CONTEXT_CHARS=9000
SITESHAHA_MAX_IMAGE_BYTES=8388608

# 公网保护：每个 IP 每分钟最多请求数，0 表示关闭限流。
SITESHAHA_RATE_LIMIT_PER_MINUTE=60
SITESHAHA_MAX_CONCURRENT_REQUESTS=4
SITESHAHA_REQUEST_TIMEOUT_SECONDS=30
SITESHAHA_TRUST_PROXY_HEADERS=false

# 可选访问码。留空时任何知道网址的人都能问答；公开投用前建议设置。
SITESHAHA_ACCESS_CODE=

# 本地运行默认监听 127.0.0.1。Docker/云平台会注入 PORT 并自动监听 0.0.0.0。
SITESHAHA_HOST=
SITESHAHA_PORT=8501
